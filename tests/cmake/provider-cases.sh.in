#!/bin/bash
# REVIEW-1.C provider-case suite (ctest-registered).
#
# Drives REAL kalos configures against the hardened FindKalosOpenBLAS
# module and asserts the external review's four-case matrix plus two
# cache-hygiene witnesses:
#
#   1 valid root                       -> configure OK + ABI probe cached
#   2 root changed to a nonexistent dir IN THE SAME BUILD DIR (the exact
#     review repro: this used to succeed on stale cache entries) -> FAIL
#     with the explicit-root diagnostic
#   3 missing root (fresh dir, root exists but has no provider) -> FAIL
#   4 fake provider: REAL headers + a libopenblas.so exporting ONLY
#     openblas_get_config (the review's "headers but missing required entry
#     points") -> FAIL on the shared LP64/CBLAS/LAPACKE link probe
#   5 installed-consumer path: the shipped module copied into a simulated
#     install cmake dir, exercised through the verbatim kalosConfig
#     find_dependency(KalosOpenBLAS REQUIRED) line -> OK with the real
#     root, FAIL with the fake provider (the check is the shared one, so
#     consumers get it too)
#   6 reconfigure WITHOUT a change (case-1 dir, same arguments) -> OK and
#     the probe is NOT re-run (cached per the selection/path signatures)
#
# Exit: 0 all cases pass, 1 any failure, 77 skip (no root-shaped provider
# at configure time - the suite self-skips on system-discovery lanes).
set -u
CMAKE="@KALOS_CMAKE@"
CXX="@KALOS_CXX@"
GEN="@KALOS_GENERATOR@"
SRC="@KALOS_SRC@"
PROVIDER_ROOT="@KALOS_ROOT@"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="$HERE/work"

if [ ! -f "$PROVIDER_ROOT/include/lapacke.h" ]; then
  echo "SKIP: provider root '$PROVIDER_ROOT' has no include/lapacke.h layout;"
  echo "SKIP: the explicit-root cases cannot run on this lane"
  exit 77
fi

FAILED=0
rm -rf "$WORK" && mkdir -p "$WORK"

pass() { echo "CASE $1: PASS ($2)"; }
fail() { echo "CASE $1: FAIL - $2"; FAILED=1; }

# cfg <dir> <logfile> [extra cmake args...] -> echo exit code
cfg() {
  local dir=$1 log=$2
  shift 2
  env -u LD_LIBRARY_PATH "$CMAKE" -S "$SRC" -B "$dir" \
      -G "$GEN" -DCMAKE_CXX_COMPILER="$CXX" \
      -DKALOS_OPENMP=OFF -DKALOS_BUILD_TESTS=OFF \
      "$@" > "$log" 2>&1
  echo $?
}

# ---- case 1: valid root ------------------------------------------------------
rc=$(cfg "$WORK/c1" "$WORK/c1.log" -DOpenBLAS_ROOT="$PROVIDER_ROOT")
if [ "$rc" = 0 ] && grep -q "KalosOpenBLAS_ABI_OK:INTERNAL=1" "$WORK/c1/CMakeCache.txt"; then
  pass 1 "valid root configures, probe green and cached"
else
  fail 1 "rc=$rc (see $WORK/c1.log)"
fi

# ---- case 2: root changed to nonexistent in the SAME build dir ---------------
rc=$(cfg "$WORK/c1" "$WORK/c2.log" -DOpenBLAS_ROOT="$WORK/nonexistent-root")
if [ "$rc" != 0 ] && grep -q "does not contain both lapacke.h" "$WORK/c2.log" \
   && grep -q "nonexistent-root" "$WORK/c2.log"; then
  pass 2 "changed-to-missing root fails loudly in the same build dir"
else
  fail 2 "rc=$rc, diagnostic check (see $WORK/c2.log)"
fi

# ---- case 3: missing root (fresh dir over an empty root) ---------------------
mkdir -p "$WORK/empty-root"
rc=$(cfg "$WORK/c3" "$WORK/c3.log" -DOpenBLAS_ROOT="$WORK/empty-root")
if [ "$rc" != 0 ] && grep -q "does not contain both lapacke.h" "$WORK/c3.log"; then
  pass 3 "missing root fails loudly on a fresh configure"
else
  fail 3 "rc=$rc, diagnostic check (see $WORK/c3.log)"
fi

# ---- fake provider: real headers, only openblas_get_config exported ----------
mkdir -p "$WORK/fake-root/lib"
cp -r "$PROVIDER_ROOT/include" "$WORK/fake-root/include"
cat > "$WORK/fake-root/fake.cpp" <<'FAKE'
// The review's pathological provider: headers present, LAPACKE/CBLAS entry
// points absent. Only openblas_get_config - the symbol the OLD probe linked
// - is exported.
extern "C" const char* openblas_get_config(void) {
  return "kalos-fake-provider (headers, no CBLAS/LAPACKE exports)";
}
FAKE
if ! env -u LD_LIBRARY_PATH "$CXX" -shared -fPIC \
     -o "$WORK/fake-root/lib/libopenblas.so" "$WORK/fake-root/fake.cpp" \
     > "$WORK/fake-build.log" 2>&1; then
  fail 4 "fake provider shared library failed to build (see $WORK/fake-build.log)"
fi

# ---- case 4: fake provider must fail the in-tree configure -------------------
rc=$(cfg "$WORK/c4" "$WORK/c4.log" -DOpenBLAS_ROOT="$WORK/fake-root")
if [ "$rc" != 0 ] && grep -q "failed the shared LP64/CBLAS/LAPACKE link probe" "$WORK/c4.log"; then
  pass 4 "headers-but-no-entry-points provider refused by the shared probe"
else
  fail 4 "rc=$rc, diagnostic check (see $WORK/c4.log)"
fi

# ---- case 5: installed-consumer path (shipped module, verbatim call) --------
mkdir -p "$WORK/inst/lib/cmake/kalos" "$WORK/consumer"
cp "$SRC/cmake/FindKalosOpenBLAS.cmake" "$WORK/inst/lib/cmake/kalos/"
{
  echo 'cmake_minimum_required(VERSION 3.20)'
  echo 'project(kalos_provider_consumer CXX)'
  # The first two statements of the SHIPPED kalosConfig.cmake.in, verbatim:
  # a consumer reaches the finder exactly this way (PACKAGE_INIT expands to
  # path setup only).
  echo 'include(CMakeFindDependencyMacro)'
  echo "list(PREPEND CMAKE_MODULE_PATH \"$WORK/inst/lib/cmake/kalos\")"
  echo 'find_dependency(KalosOpenBLAS REQUIRED)'
  echo 'message(STATUS "consumer provider: ${KalosOpenBLAS_LIBRARY}")'
} > "$WORK/consumer/CMakeLists.txt"

env -u LD_LIBRARY_PATH "$CMAKE" -S "$WORK/consumer" -B "$WORK/c5ok" \
    -G "$GEN" -DCMAKE_CXX_COMPILER="$CXX" \
    -DOpenBLAS_ROOT="$PROVIDER_ROOT" > "$WORK/c5ok.log" 2>&1
rc=$?
if [ "$rc" = 0 ] && grep -q "consumer provider: $PROVIDER_ROOT" "$WORK/c5ok.log"; then
  pass "5a" "installed-consumer finder accepts the valid root"
else
  fail "5a" "rc=$rc (see $WORK/c5ok.log)"
fi
env -u LD_LIBRARY_PATH "$CMAKE" -S "$WORK/consumer" -B "$WORK/c5bad" \
    -G "$GEN" -DCMAKE_CXX_COMPILER="$CXX" \
    -DOpenBLAS_ROOT="$WORK/fake-root" > "$WORK/c5bad.log" 2>&1
rc=$?
if [ "$rc" != 0 ] && grep -q "failed the shared LP64/CBLAS/LAPACKE link probe" "$WORK/c5bad.log"; then
  pass "5b" "installed-consumer finder refuses the fake provider"
else
  fail "5b" "rc=$rc, diagnostic check (see $WORK/c5bad.log)"
fi

# ---- case 6: reconfigure without a change keeps the cached probe -------------
# case 2 left c1 poisoned with a broken root; configure a clean dir twice.
rc=$(cfg "$WORK/c6" "$WORK/c6a.log" -DOpenBLAS_ROOT="$PROVIDER_ROOT")
rc2=$(cfg "$WORK/c6" "$WORK/c6b.log" -DOpenBLAS_ROOT="$PROVIDER_ROOT")
if [ "$rc" = 0 ] && [ "$rc2" = 0 ] \
   && grep -q "Performing Test KalosOpenBLAS_ABI_OK" "$WORK/c6a.log" \
   && ! grep -q "Performing Test KalosOpenBLAS_ABI_OK" "$WORK/c6b.log"; then
  pass 6 "unchanged reconfigure reuses the cached probe (single execution)"
else
  fail 6 "rc=$rc/$rc2, probe-execution check (see $WORK/c6[ab].log)"
fi

echo "PROVIDER CASES: $( [ $FAILED = 0 ] && echo ALL PASS || echo FAILURES )"
exit $FAILED
